module compute
workgroup_size 64 1 1

buffer out : index(0) read_write
buffer in : index(1) read

func main() {
  %0 = const 0 : u32
  %1 = load in, %0 : vec2<u32>
  %2 = const 8 : u32
  %3 = load in, %2 : vec2<u32>
  %4 = const 16 : u32
  %5 = load in, %4 : vec2<u32>
  %6 = const 448 : u32
  %7 = f64 fma, %1, %3, %5, %6 : vec2<u32>
  %8 = f64 sqrt, %7, %6 : vec2<u32>
  %9 = const 2 : u32
  %10 = f64 cmp, %8, %3, %9, %6 : bool
  %11 = f64 div_scale, %1, %3, %5, %6 : vec3<u32>
  %12 = extract %11, 2 : u32
  %13 = f64 to_i32, %8, %6 : u32
  %14 = select %10, %13, %12 : u32
  store out, %0, %8
  %15 = const 8 : u32
  store out, %15, %14
  return
}

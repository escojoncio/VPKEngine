; Fragment shader: a constant colour at location 6, the colour slot depth in tile keeps its shadow in: the variant that also writes
; the depth there cannot be made for it (the lowering refuses a shadow slot that is a shader output).
;   layout(location = 6) out vec4 color;
;   void main() { color = vec4(0.25, 0.25, 0.25, 1.0); }
OpCapability Cap:Shader
OpMemoryModel AddrModel:Logical MemModel:GLSL450
OpEntryPoint Model:Fragment %main "main" %color
OpExecutionMode %main ExecMode:OriginUpperLeft
OpName %main "main"
OpDecorate %color Deco:Location 6
%void = OpTypeVoid
%fn = OpTypeFunction %void
%f32 = OpTypeFloat 32
%v4 = OpTypeVector %f32 4
%pout = OpTypePointer Storage:Output %v4
%color = OpVariable %pout Storage:Output
%c0 = OpConstant %f32 f32:0.25
%c1 = OpConstant %f32 f32:1.0
%cv = OpConstantComposite %v4 %c0 %c0 %c0 %c1
%main = OpFunction %void 0 %fn
%l = OpLabel
OpStore %color %cv
OpReturn
OpFunctionEnd

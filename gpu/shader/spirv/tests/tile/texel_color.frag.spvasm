; Fragment shader: the colour fetched from a uniform texel buffer of Unknown format (the format of the bound view decides the
; conversion: a texel variant of the pipeline per format).
;   layout(set = 0, binding = 0) uniform textureBuffer t;
;   layout(location = 0) out vec4 color;
;   void main() { color = texelFetch(t, 0); }
OpCapability Cap:Shader
OpCapability Cap:SampledBuffer
OpMemoryModel AddrModel:Logical MemModel:GLSL450
OpEntryPoint Model:Fragment %main "main" %color
OpExecutionMode %main ExecMode:OriginUpperLeft
OpName %main "main"
OpDecorate %t Deco:DescriptorSet 0
OpDecorate %t Deco:Binding 0
OpDecorate %color Deco:Location 0
%void = OpTypeVoid
%fn = OpTypeFunction %void
%f32 = OpTypeFloat 32
%i32 = OpTypeInt 32 1
%v4 = OpTypeVector %f32 4
%img = OpTypeImage %f32 Dim:Buffer 0 0 0 1 ImgFmt:Unknown
%pimg = OpTypePointer Storage:UniformConstant %img
%t = OpVariable %pimg Storage:UniformConstant
%pout = OpTypePointer Storage:Output %v4
%color = OpVariable %pout Storage:Output
%c0 = OpConstant %i32 0
%main = OpFunction %void 0 %fn
%l = OpLabel
%tex = OpLoad %img %t
%v = OpImageFetch %v4 %tex %c0
OpStore %color %v
OpReturn
OpFunctionEnd

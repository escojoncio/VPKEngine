; Fragment shader: for (int i = 0; i < 4; ++i) { if (uv.x < 0.5) discard; } colour = 1.
; A kill inside a loop leaves the shader: the code after it would spin in a loop whose exit is on the other path.
OpCapability Cap:Shader
OpMemoryModel AddrModel:Logical MemModel:GLSL450
OpEntryPoint Model:Fragment %main "main" %uv %out
OpExecutionMode %main ExecMode:OriginUpperLeft
OpDecorate %uv Deco:Location 0
OpDecorate %out Deco:Location 0
%void = OpTypeVoid
%fn = OpTypeFunction %void
%f32 = OpTypeFloat 32
%v2 = OpTypeVector %f32 2
%v4 = OpTypeVector %f32 4
%i32 = OpTypeInt 32 1
%bool = OpTypeBool
%pin2 = OpTypePointer Storage:Input %v2
%pout4 = OpTypePointer Storage:Output %v4
%uv = OpVariable %pin2 Storage:Input
%out = OpVariable %pout4 Storage:Output
%i0 = OpConstant %i32 0
%i1 = OpConstant %i32 1
%i4 = OpConstant %i32 4
%f05 = OpConstant %f32 f32:0.5
%f1 = OpConstant %f32 f32:1.0
%c1 = OpConstantComposite %v4 %f1 %f1 %f1 %f1
%main = OpFunction %void 0 %fn
%entry = OpLabel
%u = OpLoad %v2 %uv
%ux = OpCompositeExtract %f32 %u 0
OpBranch %hdr
%hdr = OpLabel
%i = OpPhi %i32 %i0 %entry %inext %cont
%lt = OpSLessThan %bool %i %i4
OpLoopMerge %merge %cont 0
OpBranchConditional %lt %body %merge
%body = OpLabel
%k = OpFOrdLessThan %bool %ux %f05
OpSelectionMerge %after 0
OpBranchConditional %k %kill %after
%kill = OpLabel
OpKill
%after = OpLabel
OpBranch %cont
%cont = OpLabel
%inext = OpIAdd %i32 %i %i1
OpBranch %hdr
%merge = OpLabel
OpStore %out %c1
OpReturn
OpFunctionEnd

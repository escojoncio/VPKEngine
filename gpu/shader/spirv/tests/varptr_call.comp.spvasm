; version 1.3
; Compute shader: a variable pointer returned by a function. out[1] > 0.5 selects member a, else b; out[0] = the value read.
OpCapability Cap:Shader
OpCapability Cap:VariablePointersStorageBuffer
OpExtension "SPV_KHR_variable_pointers"
OpExtension "SPV_KHR_storage_buffer_storage_class"
OpMemoryModel AddrModel:Logical MemModel:GLSL450
OpEntryPoint Model:GLCompute %main "main"
OpExecutionMode %main ExecMode:LocalSize 1 1 1
OpDecorate %arr2_v4float Deco:ArrayStride 16
OpDecorate %arr2_inner_struct Deco:ArrayStride 64
OpDecorate %mat2x2_inner_struct Deco:ArrayStride 128
OpMemberDecorate %input_buffer 0 Deco:Offset 0
OpMemberDecorate %input_buffer 1 Deco:Offset 256
OpMemberDecorate %outer_struct 0 Deco:Offset 0
OpMemberDecorate %inner_struct 0 Deco:Offset 0
OpMemberDecorate %inner_struct 1 Deco:Offset 32
OpDecorate %input_buffer Deco:Block
OpDecorate %input Deco:DescriptorSet 0
OpDecorate %input Deco:Binding 0
OpDecorate %input Deco:NonWritable
OpDecorate %outblk Deco:Block
OpMemberDecorate %outblk 0 Deco:Offset 0
OpMemberDecorate %outblk 1 Deco:Offset 4
OpDecorate %out Deco:DescriptorSet 0
OpDecorate %out Deco:Binding 1
%void = OpTypeVoid
%fn = OpTypeFunction %void
%bool = OpTypeBool
%f32 = OpTypeFloat 32
%v4f32 = OpTypeVector %f32 4
%i32 = OpTypeInt 32 1
%u32 = OpTypeInt 32 0
%c_u32_2 = OpConstant %u32 2
%c_i32_0 = OpConstant %i32 0
%c_i32_1 = OpConstant %i32 1
%c_i32_2 = OpConstant %i32 2
%c_bool_true = OpConstantTrue %bool
%c_f_half = OpConstant %f32 f32:0.5
%c_bool_false = OpConstantFalse %bool
%arr2_v4float = OpTypeArray %v4f32 %c_u32_2
%inner_struct = OpTypeStruct %arr2_v4float %arr2_v4float
%arr2_inner_struct = OpTypeArray %inner_struct %c_u32_2
%mat2x2_inner_struct = OpTypeArray %arr2_inner_struct %c_u32_2
%outer_struct = OpTypeStruct %mat2x2_inner_struct
%input_buffer = OpTypeStruct %outer_struct %outer_struct
%input_buffer_ptr = OpTypePointer Storage:StorageBuffer %input_buffer
%outer_struct_ptr = OpTypePointer Storage:StorageBuffer %outer_struct
%mat2x2_ptr = OpTypePointer Storage:StorageBuffer %mat2x2_inner_struct
%sb_f32ptr = OpTypePointer Storage:StorageBuffer %f32
%input = OpVariable %input_buffer_ptr Storage:StorageBuffer
%outblk = OpTypeStruct %f32 %f32
%poutblk = OpTypePointer Storage:StorageBuffer %outblk
%out = OpVariable %poutblk Storage:StorageBuffer
%selector_func_type = OpTypeFunction %mat2x2_ptr %bool %mat2x2_ptr %mat2x2_ptr
%choose_input_func = OpFunction %mat2x2_ptr 0 %selector_func_type
%choose_first_param = OpFunctionParameter %bool
%first_param = OpFunctionParameter %mat2x2_ptr
%second_param = OpFunctionParameter %mat2x2_ptr
%selector_func_begin = OpLabel
%result_ptr = OpSelect %mat2x2_ptr %choose_first_param %first_param %second_param
OpReturnValue %result_ptr
OpFunctionEnd
%main = OpFunction %void 0 %fn
%entry = OpLabel
%in_a = OpAccessChain %outer_struct_ptr %input %c_i32_0
%in_b = OpAccessChain %outer_struct_ptr %input %c_i32_1
%a_loc = OpAccessChain %mat2x2_ptr %in_a %c_i32_0
%b_loc = OpAccessChain %mat2x2_ptr %in_b %c_i32_0
%pc = OpAccessChain %sb_f32ptr %out %c_i32_1
%cv = OpLoad %f32 %pc
%cond = OpFOrdGreaterThan %bool %cv %c_f_half
%var_ptr = OpFunctionCall %mat2x2_ptr %choose_input_func %cond %a_loc %b_loc
%result_loc = OpAccessChain %sb_f32ptr %var_ptr %c_i32_1 %c_i32_0 %c_i32_1 %c_i32_0 %c_i32_2
%result_val = OpLoad %f32 %result_loc
%po = OpAccessChain %sb_f32ptr %out %c_i32_0
OpStore %po %result_val
OpReturn
OpFunctionEnd

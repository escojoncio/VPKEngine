    0x424dd2e0u, \
    0x06492eeau, \
    0x09d1921cu, \
    0xfe1deb1cu, \
    0xb129a73eu, \
    0xe88235f5u, \
    0x2ebb4484u, \
    0xe99c7026u, \
    0xb45f7e41u, \
    0x3991d639u, \
    0x835339f4u, \
    0x9c845f8bu, \
    0xbdf9283bu, \
    0x1ff897ffu, \
    0xde05980fu, \
    0xef2f118bu, \
    0x5a0a6d1fu, \
    0x6d367ecfu, \
    0x27cb09b7u, \
    0x4f463f66u, \
    0x9e5fea2du, \
    0x7527bac7u, \
    0xebe5f17bu, \
    0x3d0739f7u, \

// Soft-float f64 library (vpir f64 op). Generated into every shader that uses it.
typedef uint u32;
typedef ulong u64;
typedef int i32;
#define VP_CLZ64(x) clz(u64(x))
#define VP_TABLE constant
#define VP_NOUNROLL _Pragma("clang loop unroll(disable)")
// Generated by tools/gen_two_over_pi.py: 2/pi as a 1201-bit binary fraction, most significant word first.
#define VPF_TWO_OVER_PI_WORDS 38
#define VPF_TWO_OVER_PI_DATA \

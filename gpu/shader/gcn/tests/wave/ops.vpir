module compute
workgroup_size 64 1 1
wave_size 64

input lid : u32 builtin(local_invocation_index)
buffer out : index(0) write

; GCN wave-64 subgroup ops in a 64-invocation workgroup: lowered to two 32-lane SIMD groups exchanging
; through threadgroup memory (ballot words, one slot per lane for broadcast / shuffle / read_first).
func main() {
  %0 = load_input lid : u32
  %1 = const 3 : u32
  %2 = and %0, %1 : u32
  %3 = const 1 : u32
  %4 = eq %2, %3 : bool
  %5 = subgroup_ballot %4 : vec4<u32>
  %6 = subgroup_any %4 : bool
  %7 = subgroup_all %4 : bool
  %8 = const 7 : u32
  %9 = mul %0, %8 : u32
  %10 = add %9, %1 : u32
  %11 = const 5 : u32
  %12 = subgroup_broadcast %10, %11 : u32
  %13 = const 63 : u32
  %14 = sub %13, %0 : u32
  %15 = subgroup_shuffle %10, %14 : u32
  %16 = subgroup_read_first %10 : u32
  %17 = const 0 : u32
  %18 = select %6, %3, %17 : u32
  %19 = select %7, %3, %17 : u32
  %20 = extract %5, 0 : u32
  %21 = extract %5, 1 : u32
  %22 = const 32 : u32
  %23 = mul %0, %22 : u32
  %24 = construct %20, %21, %18, %19 : vec4<u32>
  store out, %23, %24
  %25 = const 16 : u32
  %26 = add %23, %25 : u32
  %27 = construct %12, %15, %16, %10 : vec4<u32>
  store out, %26, %27
}

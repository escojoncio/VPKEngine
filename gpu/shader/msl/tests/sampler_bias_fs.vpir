module fragment

input uv : vec2<f32> location(0)
output color : vec4<f32> location(0)
texture albedo : 2d f32 index(0)
sampler smp : index(0)

; Emitted with EmitOptions::samplerBias: the sampler's lod bias joins the implicit lod (bias), an
; explicit lod (level) and explicit gradients (scaled by exp2).
func main() {
  %0 = load_input uv : vec2<f32>
  %1 = image_sample albedo, smp, %0 : vec4<f32>
  %2 = const 0.5 : f32
  %3 = image_sample albedo, smp, %0, lod(%2) : vec4<f32>
  %4 = image_sample albedo, smp, %0, bias(%2) : vec4<f32>
  %5 = image_sample albedo, smp, %0, grad(%0, %0) : vec4<f32>
  %6 = add %1, %3 : vec4<f32>
  %7 = add %6, %4 : vec4<f32>
  %8 = add %7, %5 : vec4<f32>
  store_output color, %8
}

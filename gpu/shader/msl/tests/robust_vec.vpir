module compute
workgroup_size 64 1 1

input gid : vec3<u32> builtin(global_invocation_id)
buffer data : index(0) read_write
buffer src : index(1) read

; Vector loads and stores of 32-bit words on a storage buffer, emitted with robustBuffers + robustPerWord (--robust-word): an access that
; crosses the end of the bound range reads / writes the words inside it. Per-word code: loads of vec4<f32>, vec2<f32>, vec3<u32>, vec4<i32>
; (data) and vec4<f32> (src, a read-only buffer, with its own BufferSize bs1) and vec4<f32> at the constant address 0; stores of vec4<f32>,
; vec2<f32>, vec3<u32>, vec4<i32> and vec2<f32> at the constant address 0. No per-word code: the scalar load (one word), and the vec4<f32>
; load at 512 whose result is never used (no access at all). (No 16-bit case: the verifier rejects F16 loads / stores.)
func main() {
  %0 = load_input gid : vec3<u32>
  %1 = extract %0, 0 : u32
  %2 = const 4 : u32
  %3 = shl %1, %2 : u32
  %4 = load data, %3 : vec4<f32>
  %5 = const 64 : u32
  %6 = add %3, %5 : u32
  %7 = load data, %6 : vec2<f32>
  %8 = const 128 : u32
  %9 = add %3, %8 : u32
  %10 = load data, %9 : vec3<u32>
  %11 = const 192 : u32
  %12 = add %3, %11 : u32
  %13 = load data, %12 : u32
  %14 = extract %4, 0 : f32
  %15 = extract %7, 1 : f32
  %16 = extract %10, 2 : u32
  %17 = bitcast %16 : f32
  %18 = add %14, %15 : f32
  %19 = add %18, %17 : f32
  %20 = bitcast %13 : f32
  %21 = add %19, %20 : f32
  %22 = construct %21, %21, %21, %21 : vec4<f32>
  %23 = const 256 : u32
  %24 = add %3, %23 : u32
  %25 = load data, %24 : vec4<i32>
  %26 = const 512 : u32
  %27 = add %3, %26 : u32
  %28 = load data, %27 : vec4<f32>
  %38 = load src, %3 : vec4<f32>
  %39 = const 0 : u32
  %40 = load data, %39 : vec4<f32>
  %41 = extract %25, 3 : i32
  %42 = bitcast %41 : f32
  %43 = extract %38, 1 : f32
  %44 = extract %40, 2 : f32
  %45 = add %42, %43 : f32
  %46 = add %45, %44 : f32
  %29 = construct %46, %46 : vec2<f32>
  %30 = construct %46, %46, %46 : vec3<f32>
  %31 = bitcast %30 : vec3<u32>
  %32 = construct %41, %41, %41, %41 : vec4<i32>
  store data, %6, %29
  store data, %9, %31
  store data, %24, %32
  store data, %39, %29
  store data, %3, %22
}

module compute
workgroup_size 32 1 1

input gid : vec3<u32> builtin(global_invocation_id)
input lane : u32 builtin(subgroup_invocation)
buffer out : index(0) write
buffer src : index(1) read

func main() {
  %0 = load_input gid : vec3<u32>
  %1 = extract %0, 0 : u32
  %2 = load_input lane : u32
  %3 = const 2 : u32
  %4 = shl %1, %3 : u32
  %5 = load src, %4 : f32
  %6 = bitcast %5 : u32
  %7 = subgroup_arith %5, %2, 0, 0, 0, 0 : f32
  %8 = subgroup_arith %5, %2, 0, 1, 0, 0 : f32
  %9 = subgroup_arith %6, %2, 1, 2, 0, 1 : u32
  %10 = subgroup_arith %5, %2, 2, 2, 0, 0 : f32
  %11 = subgroup_arith %6, %2, 3, 3, 4, 0 : u32
  %12 = subgroup_arith %6, %2, 4, 0, 0, 4294967295 : u32
  %13 = construct %5, %5 : vec2<f32>
  %14 = subgroup_arith %13, %2, 2, 3, 2, 0 : vec2<f32>
  %15 = const 4 : u32
  %16 = shl %1, %15 : u32
  store out, %16, %7
  %17 = const 4 : u32
  %18 = add %16, %17 : u32
  store out, %18, %8
  %19 = add %18, %17 : u32
  store out, %19, %9
  %20 = add %19, %17 : u32
  store out, %20, %10
  %21 = add %20, %17 : u32
  store out, %21, %11
  %22 = add %21, %17 : u32
  store out, %22, %12
  %23 = add %22, %17 : u32
  store out, %23, %14
}

module fragment

input frag_pos : vec4<f32> builtin(position)
input sid : u32 builtin(sample_id)
input view : u32 builtin(layer)
output color : vec4<f32> location(0)
texture depth_in : 2d_array f32 depth multisample index(0)

; fetch-map: 0=6
; Subpass input of a multisampled depth image: this pixel, this view, this sample.
func main() {
  %0 = load_input frag_pos : vec4<f32>
  %1 = shuffle %0, %0, 0, 1 : vec2<f32>
  %2 = convert %1 : vec2<u32>
  %3 = extract %2, 0 : u32
  %4 = extract %2, 1 : u32
  %5 = load_input view : u32
  %6 = construct %3, %4, %5 : vec3<u32>
  %7 = load_input sid : u32
  %8 = image_fetch depth_in, %6, lod(%7) : f32
  %99 = construct %8, %8, %8, %8 : vec4<f32>
  store_output color, %99
}

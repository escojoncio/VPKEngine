#beginTestCaseResult dEQP-GLES31.functional.texture.multisample.samples_4.sample_mask_only
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES31.functional.texture.multisample.samples_4.sample_mask_only" Version="0.3.4" CaseType="SelfValidate">
 <Text>glGetInternalformativ(GL_SAMPLES) = 4</Text>
 <Text>Creating multisample texture with sample count 4</Text>
 <Text>Attaching texture to FBO</Text>
 <Section Name="GenerateSamplerShader" Description="Generate sampler shader">
  <ShaderProgram LinkStatus="OK">
   <InfoLog></InfoLog>
   <VertexShader CompileStatus="OK">
    <ShaderSource>#version 310 es
in highp vec4 a_position;
void main (void)
{
    gl_Position = a_position;
}
</ShaderSource>
    <InfoLog></InfoLog>
</VertexShader>
   <FragmentShader CompileStatus="OK">
    <ShaderSource>#version 310 es
layout(location = 0) out highp vec4 fragColor;
uniform highp sampler2DMS u_sampler;
uniform highp int u_sample;
void main (void)
{
    highp float correctCoverage = 0.0;
    highp float incorrectCoverage = 0.0;
    highp ivec2 texelPos = ivec2(int(floor(gl_FragCoord.x)), int(floor(gl_FragCoord.y)));

    for (int sampleNdx = 0; sampleNdx &lt; 4; ++sampleNdx)
    {
        highp float sampleColor = texelFetch(u_sampler, texelPos, sampleNdx).r;
        if (sampleNdx == u_sample)
            correctCoverage += sampleColor;
        else
            incorrectCoverage += sampleColor;
    }
    fragColor = vec4(correctCoverage, incorrectCoverage, 0.0, 1.0);
}
</ShaderSource>
    <InfoLog></InfoLog>
</FragmentShader>
</ShaderProgram>
  <Number Name="VertexCompileTime" Description="Vertex shader compile time" Tag="Time" Unit="ms">0.064000</Number>
  <Number Name="FragmentCompileTime" Description="Fragment shader compile time" Tag="Time" Unit="ms">0.086000</Number>
  <Number Name="LinkTime" Description="Link time" Tag="Time" Unit="ms">0.098000</Number>
</Section>

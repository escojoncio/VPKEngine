#beginTestCaseResult dEQP-GLES31.functional.debug.negative_coverage.callbacks.buffer.blit_framebuffer_multisample
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES31.functional.debug.negative_coverage.callbacks.buffer.blit_framebuffer_multisample" Version="0.3.4" CaseType="SelfValidate">
 <Text>glGenFramebuffers(2, 0x000000016f0a5670);</Text>
 <Text>// framebuffers = { 38, 39 }</Text>
 <Text>glGenRenderbuffers(2, 0x000000016f0a5668);</Text>
 <Text>// renderbuffers = { 11438, 11439 }</Text>
 <Text>glBindRenderbuffer(GL_RENDERBUFFER, 11438);</Text>
 <Text>glBindFramebuffer(GL_READ_FRAMEBUFFER, 38);</Text>
 <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, 4, GL_RGBA8, 32, 32);</Text>
 <Text>glFramebufferRenderbuffer(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, 11438);</Text>
 <Text>glCheckFramebufferStatus(GL_READ_FRAMEBUFFER);</Text>
 <Text>// GL_FRAMEBUFFER_COMPLETE returned</Text>
 <Text>glBindRenderbuffer(GL_RENDERBUFFER, 11439);</Text>
 <Text>glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 39);</Text>
 <Section Name="callstream" Description="GL_INVALID_OPERATION is generated if the value of GL_SAMPLE_BUFFERS for the draw buffer is greater than zero.">
  <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, 4, GL_RGBA8, 32, 32);</Text>
  <Text>glFramebufferRenderbuffer(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, 11439);</Text>
  <Text>glBlitFramebuffer(0, 0, 16, 16, 0, 0, 16, 16, GL_COLOR_BUFFER_BIT, GL_NEAREST);</Text>
  <Text>Driver says: &quot;GL_INVALID_OPERATION&quot;</Text>
</Section>
 <Section Name="callstream" Description="GL_INVALID_OPERATION is generated if GL_SAMPLE_BUFFERS for the read buffer is greater than zero and the formats of draw and read buffers are not identical.">
  <Text>glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA4, 32, 32);</Text>
  <Text>glFramebufferRenderbuffer(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, 11439);</Text>
  <Text>glBlitFramebuffer(0, 0, 16, 16, 0, 0, 16, 16, GL_COLOR_BUFFER_BIT, GL_NEAREST);</Text>
  <Text>Driver says: &quot;GL_INVALID_OPERATION&quot;</Text>
</Section>
 <Section Name="callstream" Description="GL_INVALID_OPERATION is generated if GL_SAMPLE_BUFFERS for the read buffer is greater than zero and the source and destination rectangles are not defined with the same (X0, Y0) and (X1, Y1) bounds.">
  <Text>glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA8, 32, 32);</Text>
  <Text>glFramebufferRenderbuffer(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, 11439);</Text>
  <Text>glBlitFramebuffer(0, 0, 16, 16, 2, 2, 18, 18, GL_COLOR_BUFFER_BIT, GL_NEAREST);</Text>
  <Text>A message was expected but none was reported. Running without a debug context</Text>
</Section>
 <Text>glBindFramebuffer(GL_FRAMEBUFFER, 0);</Text>

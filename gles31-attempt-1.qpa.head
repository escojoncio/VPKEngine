     <ShaderSource>#version 310 es
in mediump float interpolant;
precision mediump float;
void main()
{
    interpolateAtSample(interpolant, 1);
}
</ShaderSource>
     <InfoLog>ERROR: 0:6: &apos;interpolateAtSample&apos; : no matching overloaded function found
</InfoLog>
</FragmentShader>
</ShaderProgram>
</Section>
</Section>

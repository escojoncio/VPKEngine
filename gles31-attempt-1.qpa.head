 <Text>glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 43);</Text>
 <Section Name="callstream" Description="GL_INVALID_OPERATION is generated if the value of GL_SAMPLE_BUFFERS for the draw buffer is greater than zero.">
  <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, 4, GL_RGBA8, 32, 32);</Text>
  <Text>glFramebufferRenderbuffer(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, 11459);</Text>
  <Text>glBlitFramebuffer(0, 0, 16, 16, 0, 0, 16, 16, GL_COLOR_BUFFER_BIT, GL_NEAREST);</Text>
</Section>
 <Section Name="callstream" Description="GL_INVALID_OPERATION is generated if GL_SAMPLE_BUFFERS for the read buffer is greater than zero and the formats of draw and read buffers are not identical.">
  <Text>glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA4, 32, 32);</Text>
  <Text>glFramebufferRenderbuffer(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, 11459);</Text>
  <Text>glBlitFramebuffer(0, 0, 16, 16, 0, 0, 16, 16, GL_COLOR_BUFFER_BIT, GL_NEAREST);</Text>
</Section>
 <Section Name="callstream" Description="GL_INVALID_OPERATION is generated if GL_SAMPLE_BUFFERS for the read buffer is greater than zero and the source and destination rectangles are not defined with the same (X0, Y0) and (X1, Y1) bounds.">
  <Text>glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA8, 32, 32);</Text>
  <Text>glFramebufferRenderbuffer(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, 11459);</Text>
  <Text>glBlitFramebuffer(0, 0, 16, 16, 2, 2, 18, 18, GL_COLOR_BUFFER_BIT, GL_NEAREST);</Text>
  <Text>GL_INVALID_OPERATION was expected but got GL_NO_ERROR</Text>
</Section>
 <Text>glBindFramebuffer(GL_FRAMEBUFFER, 0);</Text>
 <Text>glDeleteRenderbuffers(2, { 11458, 11459 });</Text>
 <Text>glDeleteFramebuffers(2, { 42, 43 });</Text>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">15019</Number>
 <Result StatusCode="Fail">Incorrect error was reported</Result>
</TestCaseResult>

#endTestCaseResult

#beginTestCaseResult dEQP-GLES31.functional.debug.negative_coverage.get_error.buffer.renderbuffer_storage_multisample
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES31.functional.debug.negative_coverage.get_error.buffer.renderbuffer_storage_multisample" Version="0.3.4" CaseType="SelfValidate">
 <Text>glGetInternalformativ(GL_RENDERBUFFER, GL_RGBA4, GL_SAMPLES, 1, 0x000000016f0a5668);</Text>
 <Text>// params = { 4 }</Text>
 <Text>glGetInternalformativ(GL_RENDERBUFFER, GL_RGBA8UI, GL_SAMPLES, 1, 0x000000016f0a5664);</Text>
 <Text>// params = { 0 }</Text>
 <Text>glGenRenderbuffers(1, 0x000000016f0a566c);</Text>
 <Text>// renderbuffers = { 11460 }</Text>
 <Text>glBindRenderbuffer(GL_RENDERBUFFER, 11460);</Text>
 <Section Name="callstream" Description="GL_INVALID_ENUM is generated if target is not GL_RENDERBUFFER.">
  <Text>glRenderbufferStorageMultisample(0xffffffffffffffff, 2, GL_RGBA4, 1, 1);</Text>
  <Text>glRenderbufferStorageMultisample(GL_FRAMEBUFFER, 2, GL_RGBA4, 1, 1);</Text>
</Section>
 <Section Name="callstream" Description="GL_INVALID_OPERATION is generated if samples is greater than the maximum number of samples supported for internalformat.">
  <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, 5, GL_RGBA4, 1, 1);</Text>
</Section>
 <Section Name="callstream" Description="GL_INVALID_ENUM is generated if internalformat is not a color-renderable, depth-renderable, or stencil-renderable format.">
  <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, 2, 0xffffffffffffffff, 1, 1);</Text>
  <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, 2, GL_RGBA8_SNORM, 1, 1);</Text>
</Section>
 <Section Name="callstream" Description="GL_INVALID_OPERATION is generated if samples is greater than the maximum number of samples supported for internalformat. (Unsigned integer format)">
  <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, 1, GL_RGBA8UI, 1, 1);</Text>
  <Text>GL_INVALID_OPERATION was expected but got GL_NO_ERROR</Text>
</Section>
 <Section Name="callstream" Description="GL_INVALID_VALUE is generated if width or height is less than zero.">
  <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, 2, GL_RGBA4, -1, 1);</Text>
  <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, 2, GL_RGBA4, 1, -1);</Text>
  <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, 2, GL_RGBA4, -1, -1);</Text>
  <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, -1, GL_RGBA4, 1, 1);</Text>
  <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, -1, GL_RGBA4, -1, 1);</Text>
  <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, -1, GL_RGBA4, 1, -1);</Text>
  <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, -1, GL_RGBA4, -1, -1);</Text>
</Section>
 <Section Name="callstream" Description="GL_INVALID_VALUE is generated if width or height is greater than GL_MAX_RENDERBUFFER_SIZE.">
  <Text>glGetIntegerv(GL_MAX_RENDERBUFFER_SIZE, 0x000000016f0a5660);</Text>
  <Text>// data = { 16384 }</Text>
  <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, 4, GL_RGBA4, 1, 16385);</Text>
  <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, 4, GL_RGBA4, 16385, 1);</Text>
  <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, 4, GL_RGBA4, 16385, 16385);</Text>
</Section>
 <Text>glDeleteRenderbuffers(1, { 11460 });</Text>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">2455</Number>
 <Result StatusCode="Fail">Incorrect error was reported</Result>
</TestCaseResult>

#endTestCaseResult


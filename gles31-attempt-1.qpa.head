     <ShaderSource>#version 310 es
    sample out highp float v_var;
precision mediump float;
void main()
{
}
</ShaderSource>
     <InfoLog>ERROR: 0:2: &apos;sample&apos; : unknown type
</InfoLog>
</FragmentShader>
</ShaderProgram>
</Section>
  <Section Name="callstream" Description="Test interpolateAt* functions.">

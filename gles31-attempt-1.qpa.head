#beginTestCaseResult dEQP-GLES31.functional.state_query.texture_level.texture_2d_multisample.samples_integer
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES31.functional.state_query.texture_level.texture_2d_multisample.samples_integer" Version="0.3.4" CaseType="SelfValidate">
 <Section Name="Iteration" Description="Iteration 1/4 - GL_TEXTURE_2D_MULTISAMPLE, initial values">
  <Text>glGenTextures(1, 0x00000009c4e466a0);</Text>
  <Text>// textures = { 387 }</Text>
  <Text>glBindTexture(GL_TEXTURE_2D_MULTISAMPLE, 387);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>Verifying GL_TEXTURE_SAMPLES, expecting 0 or greater</Text>
  <Text>glGetTexLevelParameteriv(GL_TEXTURE_2D_MULTISAMPLE, 0, GL_TEXTURE_SAMPLES, 0x000000016f0a5224);</Text>
  <Text>// params = { 0 }</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glDeleteTextures(1, { 387 });</Text>
</Section>
 <Section Name="Iteration" Description="Iteration 2/4 - GL_TEXTURE_2D_MULTISAMPLE, low sample count">
  <Text>glGenTextures(1, 0x00000009c4e466a0);</Text>
  <Text>// textures = { 388 }</Text>
  <Text>glBindTexture(GL_TEXTURE_2D_MULTISAMPLE, 388);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glTexStorage2DMultisample(GL_TEXTURE_2D_MULTISAMPLE, 1, GL_RGBA8, 16, 16, GL_FALSE);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>Verifying GL_TEXTURE_SAMPLES, expecting 1 or greater</Text>
  <Text>glGetTexLevelParameteriv(GL_TEXTURE_2D_MULTISAMPLE, 0, GL_TEXTURE_SAMPLES, 0x000000016f0a5224);</Text>
  <Text>// params = { 1 }</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glDeleteTextures(1, { 388 });</Text>
</Section>
 <Section Name="Iteration" Description="Iteration 3/4 - GL_TEXTURE_2D_MULTISAMPLE, high sample count">
  <Text>glGenTextures(1, 0x00000009c4e466a0);</Text>
  <Text>// textures = { 389 }</Text>
  <Text>glBindTexture(GL_TEXTURE_2D_MULTISAMPLE, 389);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glTexStorage2DMultisample(GL_TEXTURE_2D_MULTISAMPLE, 4, GL_RGBA8, 32, 32, GL_FALSE);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>Verifying GL_TEXTURE_SAMPLES, expecting 4 or greater</Text>
  <Text>glGetTexLevelParameteriv(GL_TEXTURE_2D_MULTISAMPLE, 0, GL_TEXTURE_SAMPLES, 0x000000016f0a5224);</Text>
  <Text>// params = { 4 }</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glDeleteTextures(1, { 389 });</Text>
</Section>

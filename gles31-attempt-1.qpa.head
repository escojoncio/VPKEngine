<TestCaseResult CasePath="dEQP-GLES31.functional.debug.negative_coverage.get_error.buffer.blit_framebuffer_multisample" Version="0.3.4" CaseType="SelfValidate">
 <Text>glGenFramebuffers(2, 0x000000016f0a5670);</Text>
 <Text>// framebuffers = { 42, 43 }</Text>
 <Text>glGenRenderbuffers(2, 0x000000016f0a5668);</Text>
 <Text>// renderbuffers = { 11458, 11459 }</Text>
 <Text>glBindRenderbuffer(GL_RENDERBUFFER, 11458);</Text>
 <Text>glBindFramebuffer(GL_READ_FRAMEBUFFER, 42);</Text>
 <Text>glRenderbufferStorageMultisample(GL_RENDERBUFFER, 4, GL_RGBA8, 32, 32);</Text>
 <Text>glFramebufferRenderbuffer(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, 11458);</Text>
 <Text>glCheckFramebufferStatus(GL_READ_FRAMEBUFFER);</Text>
 <Text>// GL_FRAMEBUFFER_COMPLETE returned</Text>

#beginTestCaseResult dEQP-GLES31.functional.texture.multisample.samples_1.sample_position
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES31.functional.texture.multisample.samples_1.sample_position" Version="0.3.4" CaseType="SelfValidate">
 <Text>GL_MAX_COLOR_TEXTURE_SAMPLES = 4</Text>
 <Text>GL_SUBPIXEL_BITS = 8</Text>
 <Text>Creating multisample texture</Text>
 <Text>Attaching texture to FBO</Text>
 <Text>Sample locations:</Text>
 <Text>	0: (0.5, 0.5)</Text>
 <Text>Drawing test pattern to the texture</Text>
 <Section Name="Generate sampler shader" Description="Generate sampler shader">
  <ShaderProgram LinkStatus="OK">
   <InfoLog></InfoLog>
   <VertexShader CompileStatus="OK">
    <ShaderSource>#version 310 es
in highp vec4 a_position;
void main (void)
{
    gl_Position = a_position;
}
</ShaderSource>
    <InfoLog></InfoLog>
</VertexShader>
   <FragmentShader CompileStatus="OK">
    <ShaderSource>#version 310 es
layout(location = 0) out highp vec4 fragColor;
uniform highp sampler2DMS u_sampler;
uniform highp int u_sample;
void main (void)
{
    fragColor = texelFetch(u_sampler, ivec2(int(floor(gl_FragCoord.x)), int(floor(gl_FragCoord.y))), u_sample);
}
</ShaderSource>
    <InfoLog></InfoLog>
</FragmentShader>
</ShaderProgram>

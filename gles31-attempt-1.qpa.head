</ShaderSource>
    <InfoLog></InfoLog>
</VertexShader>
   <FragmentShader CompileStatus="OK">
    <ShaderSource>#version 310 es
layout(location = 0) out highp vec4 fragColor;
uniform highp float u_writeValue;
void main (void)
{
    fragColor = vec4(0.0, 0.0, 0.0, 1.0);
    gl_FragDepth = u_writeValue;
}
</ShaderSource>

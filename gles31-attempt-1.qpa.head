#beginTestCaseResult dEQP-GLES31.functional.texture.multisample.samples_2.use_texture_color_2d
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES31.functional.texture.multisample.samples_2.use_texture_color_2d" Version="0.3.4" CaseType="SelfValidate">
 <Text>Max sample count for GL_R8: 4</Text>
 <Text>Creating multisample  texture</Text>
 <Text>Attaching multisample texture to fbo</Text>
 <Section Name="RenderShader" Description="Generate render-to-texture shader">
  <ShaderProgram LinkStatus="OK">
   <InfoLog></InfoLog>
   <VertexShader CompileStatus="OK">
    <ShaderSource>#version 310 es
in highp vec4 a_position;
void main (void)
{
    gl_Position = a_position;
}
</ShaderSource>
    <InfoLog></InfoLog>
</VertexShader>
   <FragmentShader CompileStatus="OK">
    <ShaderSource>#version 310 es
layout(location = 0) out highp vec4 fragColor;
uniform highp float u_writeValue;
void main (void)
{
    fragColor = vec4(vec4(u_writeValue, 1.0, 1.0, 1.0));
}
</ShaderSource>
    <InfoLog></InfoLog>
</FragmentShader>
</ShaderProgram>
  <Number Name="VertexCompileTime" Description="Vertex shader compile time" Tag="Time" Unit="ms">0.049000</Number>
  <Number Name="FragmentCompileTime" Description="Fragment shader compile time" Tag="Time" Unit="ms">0.039000</Number>
  <Number Name="LinkTime" Description="Link time" Tag="Time" Unit="ms">0.056000</Number>
</Section>
 <Section Name="SamplerShader" Description="Generate texture sampler shader">
  <ShaderProgram LinkStatus="OK">
   <InfoLog></InfoLog>
   <VertexShader CompileStatus="OK">
    <ShaderSource>#version 310 es
in highp vec4 a_position;
out highp float v_gradient;
void main (void)
{
    gl_Position = a_position;
    v_gradient = a_position.x * 0.5 + 0.5;
}
</ShaderSource>
    <InfoLog></InfoLog>
</VertexShader>
   <FragmentShader CompileStatus="OK">
    <ShaderSource>#version 310 es
layout(location = 0) out highp vec4 fragColor;
uniform highp sampler2DMS u_sampler;
uniform highp int u_maxSamples;
uniform highp int u_layer;
uniform highp float u_cmpValue;
in highp float v_gradient;
void main (void)
{
    const highp vec4 okColor = vec4(0.0, 1.0, 0.0, 1.0);
    const highp vec4 failColor = vec4(1.0, 0.0, 0.0, 1.0);
    const highp float epsilon = 0.1;

    highp int sampleNdx = clamp(int(floor(v_gradient * float(u_maxSamples))), 0, u_maxSamples-1);
    highp float value = float(texelFetch(u_sampler, ivec2(floor(gl_FragCoord.xy)), sampleNdx).r);
    fragColor = (abs(u_cmpValue - value) &lt; epsilon) ? (okColor) : (failColor);
}
</ShaderSource>
    <InfoLog></InfoLog>
</FragmentShader>
</ShaderProgram>
  <Number Name="VertexCompileTime" Description="Vertex shader compile time" Tag="Time" Unit="ms">0.030000</Number>
  <Number Name="FragmentCompileTime" Description="Fragment shader compile time" Tag="Time" Unit="ms">0.097000</Number>
  <Number Name="LinkTime" Description="Link time" Tag="Time" Unit="ms">0.070000</Number>
</Section>
 <Section Name="Sample" Description="Render to texture and sample texture">
  <Text>Filling multisample texture with value 0.219218</Text>
  <Text>Sampling from texture.</Text>
  <Text>Verifying image.</Text>
  <Text>No invalid pixels found.</Text>
</Section>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">43498</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult

